{
  "name": "@evoworkflow/cli",
  "version": "0.4.0",
  "private": true,
  "description": "Human-controlled, repository-centered AI software engineering workflow",
  "type": "module",
  "bin": {
    "evo": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "skills"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.19.0",
  "oclif": {
    "bin": "evo",
    "dirname": "evoworkflow",
    "commands": "./dist/commands",
    "topicSeparator": " "
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run smoke:cli && pnpm run validate:skills && pnpm run check:schemas && pnpm run eval:phase2 && pnpm run eval:phase3 && pnpm run eval:hardening && pnpm run eval:cross-agent && pnpm run smoke:package",
    "check:schemas": "tsx scripts/check-schemas.ts",
    "dev": "tsx src/index.ts",
    "evo": "tsx src/index.ts",
    "eval:ruoyi": "tsx scripts/phase2-ruoyi-smoke.ts",
    "eval:hardening": "tsx scripts/hardening-evals.ts",
    "eval:phase2": "tsx scripts/phase2-evals.ts",
    "eval:phase3": "tsx scripts/phase3-evals.ts",
    "eval:phase3:continuity": "tsx scripts/phase3-development-continuity.ts",
    "eval:cross-agent": "tsx scripts/cross-agent-evals.ts",
    "eval:cross-agent:behavioral": "tsx scripts/cross-agent-behavioral.ts",
    "eval:ruoyi:phase3": "tsx scripts/phase3-ruoyi-smoke.ts",
    "eval:ruoyi:phase3:behavioral": "tsx scripts/phase3-ruoyi-behavioral.ts",
    "generate:schemas": "tsx scripts/generate-schemas.ts",
    "generate:skill-manifest": "tsx scripts/generate-skill-manifest.ts",
    "smoke:cli": "tsx scripts/smoke-cli.ts",
    "smoke:package": "tsx scripts/package-smoke.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate:skills": "tsx scripts/validate-skills.ts"
  },
  "dependencies": {
    "@oclif/core": "^5.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
