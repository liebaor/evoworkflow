{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/config-v2.json",
  "title": "evoworkflow Config v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "project": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "defaultWeight": {
          "type": "string",
          "enum": [
            "SMALL",
            "STANDARD",
            "LARGE"
          ]
        },
        "requireHumanApproval": {
          "type": "boolean",
          "const": true
        },
        "autoCommit": {
          "type": "boolean",
          "const": false
        },
        "autoFinish": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "defaultWeight",
        "requireHumanApproval",
        "autoCommit",
        "autoFinish"
      ],
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "properties": {
        "staleWorkDays": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "agentsMaxLines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "staleWorkDays",
        "agentsMaxLines"
      ],
      "additionalProperties": false
    },
    "goal": {
      "type": "object",
      "properties": {
        "defaultAdapter": {
          "type": "string",
          "minLength": 1
        },
        "maxAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      },
      "required": [
        "defaultAdapter",
        "maxAttempts"
      ],
      "additionalProperties": false
    },
    "agents": {
      "type": "object",
      "properties": {
        "adapters": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "codex",
                  "claude",
                  "opencode",
                  "process"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "default": 3600000,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 86400000
              }
            },
            "required": [
              "kind",
              "command",
              "args",
              "timeoutMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "adapters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "project",
    "workflow",
    "knowledge",
    "goal",
    "agents"
  ],
  "additionalProperties": false
}
