{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/resolved-constraints-v1.json",
  "title": "evoworkflow Resolved Constraints v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "freshness": {
      "type": "string",
      "enum": [
        "CURRENT",
        "STALE",
        "UNKNOWN",
        "MISSING",
        "CONFLICT"
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^C-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "type": {
            "type": "string",
            "enum": [
              "HARD",
              "SOFT",
              "REFERENCE",
              "UNKNOWN",
              "CONFLICT"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "DECISION",
                  "AUTHORITY",
                  "CONTRACT",
                  "PROJECT_MAP",
                  "REPRESENTATIVE_CODE",
                  "INFERENCE"
                ]
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "type",
          "topic",
          "statement",
          "source",
          "scope",
          "evidence",
          "fingerprint"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "change",
    "generatedAt",
    "inputFingerprint",
    "inputs",
    "freshness",
    "constraints"
  ],
  "additionalProperties": false
}
