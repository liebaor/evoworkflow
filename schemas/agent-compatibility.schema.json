{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/agent-compatibility-v1.json",
  "title": "evoworkflow Agent Compatibility v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "canonicalInstruction": {
      "type": [
        "string",
        "null"
      ]
    },
    "clients": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client": {
            "type": "string",
            "enum": [
              "codex",
              "claude-code",
              "opencode"
            ]
          },
          "executable": {
            "type": "string",
            "enum": [
              "FOUND",
              "MISSING"
            ]
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "instructionSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skillSources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "client",
          "executable",
          "version",
          "instructionSources",
          "skillSources"
        ],
        "additionalProperties": false
      }
    },
    "manifest": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "CURRENT",
            "MISSING",
            "STALE",
            "INVALID"
          ]
        },
        "expectedVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "actualVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "driftedSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "expectedVersion",
        "actualVersion",
        "driftedSkills"
      ],
      "additionalProperties": false
    },
    "duplicateSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "severity": {
            "type": "string",
            "enum": [
              "ERROR",
              "WARNING",
              "INFO"
            ]
          },
          "client": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "codex",
                  "claude-code",
                  "opencode"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "path": {
            "type": [
              "string",
              "null"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "severity",
          "client",
          "path",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "recommendedNextAction": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "canonicalInstruction",
    "clients",
    "manifest",
    "duplicateSkillIds",
    "diagnostics",
    "recommendedNextAction"
  ],
  "additionalProperties": false
}
