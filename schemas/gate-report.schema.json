{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/gate-report-v1.json",
  "title": "evoworkflow Gate Report v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "evaluatedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_RUN",
        "WARN"
      ]
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PROTOCOL",
              "PROJECT"
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "HARD",
              "WARNING"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "WARN"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "falsifyingCase": {
            "type": "string",
            "minLength": 1
          },
          "negativeRegression": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluatedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "enforcement",
          "status",
          "title",
          "detail",
          "authority",
          "predicate",
          "falsifyingCase",
          "negativeRegression",
          "remediation",
          "evidence",
          "evaluatedAt"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "change",
    "evaluatedAt",
    "status",
    "gates"
  ],
  "additionalProperties": false
}
