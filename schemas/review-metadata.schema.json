{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/review-metadata-v1.json",
  "title": "evoworkflow Review Metadata v1",
  "type": "object",
  "properties": {
    "change": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "NEEDS_INFO",
        "AWAITING_APPROVAL",
        "APPROVED",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "humanAcceptance": {
      "type": "boolean"
    },
    "openFindings": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "docsConverged": {
      "type": "boolean"
    },
    "deferredAcceptance": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^AC-[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"
      }
    },
    "acceptedLimitations": {
      "default": false,
      "type": "boolean"
    }
  },
  "required": [
    "change",
    "status",
    "humanAcceptance",
    "openFindings",
    "docsConverged",
    "deferredAcceptance",
    "acceptedLimitations"
  ],
  "additionalProperties": false
}
