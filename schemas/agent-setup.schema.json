{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/agent-setup-v1.json",
  "title": "evoworkflow Agent Setup v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "enum": [
        "PREVIEW",
        "APPLIED"
      ]
    },
    "action": {
      "type": "string",
      "enum": [
        "CREATE_CLAUDE_BRIDGE",
        "ALREADY_CONFIGURED",
        "NEEDS_HUMAN_MERGE",
        "BLOCKED"
      ]
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    },
    "content": {
      "type": [
        "string",
        "null"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "installGuidance": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "generatedAt",
    "repository",
    "mode",
    "action",
    "path",
    "content",
    "reason",
    "installGuidance"
  ],
  "additionalProperties": false
}
