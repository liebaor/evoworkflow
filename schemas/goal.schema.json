{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/goal-v1.json",
  "title": "evoworkflow Goal v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "changeId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "adapter": {
      "type": "string",
      "minLength": 1
    },
    "maxAttempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "APPROVED",
        "RUNNING",
        "BLOCKED",
        "READY_FOR_REVIEW",
        "CANCELLED"
      ]
    },
    "stopConditions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "REQUIREMENT_AMBIGUITY",
          "ACCEPTANCE_CHANGE",
          "ARCHITECTURE_DEVIATION",
          "BREAKING_API",
          "SECURITY_DECISION",
          "DESTRUCTIVE_DATA_OPERATION",
          "UNEXPECTED_DEPENDENCY",
          "SCOPE_EXPANSION",
          "REPEATED_FAILURE",
          "TRANSIENT_FAILURE"
        ]
      }
    },
    "slices": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verify": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": {
                  "type": "string",
                  "minLength": 1
                },
                "args": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "timeoutMs": {
                  "default": 300000,
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 3600000
                }
              },
              "required": [
                "command",
                "args",
                "label",
                "timeoutMs"
              ],
              "additionalProperties": false
            }
          },
          "status": {
            "default": "PENDING",
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "PASS",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "attempts": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "number": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "epoch": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "startedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "endedAt": {
                  "type": "string",
                  "minLength": 1
                },
                "agent": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "COMPLETED",
                        "BLOCKED"
                      ]
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1
                    },
                    "changedFiles": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "evidence": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "stopCondition": {
                      "default": null,
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "REQUIREMENT_AMBIGUITY",
                            "ACCEPTANCE_CHANGE",
                            "ARCHITECTURE_DEVIATION",
                            "BREAKING_API",
                            "SECURITY_DECISION",
                            "DESTRUCTIVE_DATA_OPERATION",
                            "UNEXPECTED_DEPENDENCY",
                            "SCOPE_EXPANSION",
                            "REPEATED_FAILURE",
                            "TRANSIENT_FAILURE"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "status",
                    "summary",
                    "changedFiles",
                    "evidence",
                    "stopCondition"
                  ],
                  "additionalProperties": false
                },
                "verification": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": {
                        "type": "string",
                        "minLength": 1
                      },
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "args": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "status": {
                        "type": "string",
                        "enum": [
                          "PASS",
                          "FAIL",
                          "BLOCKED",
                          "NOT_RUN"
                        ]
                      },
                      "exitCode": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "output": {
                        "type": "string"
                      },
                      "startedAt": {
                        "type": "string",
                        "minLength": 1
                      },
                      "endedAt": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "label",
                      "command",
                      "args",
                      "status",
                      "exitCode",
                      "output",
                      "startedAt",
                      "endedAt"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "number",
                "epoch",
                "startedAt",
                "endedAt",
                "agent",
                "verification"
              ],
              "additionalProperties": false
            }
          },
          "blockReason": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "stopCondition": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "REQUIREMENT_AMBIGUITY",
                  "ACCEPTANCE_CHANGE",
                  "ARCHITECTURE_DEVIATION",
                  "BREAKING_API",
                  "SECURITY_DECISION",
                  "DESTRUCTIVE_DATA_OPERATION",
                  "UNEXPECTED_DEPENDENCY",
                  "SCOPE_EXPANSION",
                  "REPEATED_FAILURE",
                  "TRANSIENT_FAILURE"
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "objective",
          "acceptance",
          "dependsOn",
          "verify",
          "status",
          "attempts",
          "blockReason",
          "stopCondition"
        ],
        "additionalProperties": false
      }
    },
    "approval": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "approvedAt": {
              "type": "string",
              "minLength": 1
            },
            "approvedBy": {
              "type": "string",
              "const": "human"
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "contextFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "approvedAt",
            "approvedBy",
            "fingerprint",
            "contextFingerprint"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "runEpoch": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "resumes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "at",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "changeId",
    "repository",
    "adapter",
    "maxAttempts",
    "status",
    "stopConditions",
    "slices",
    "approval",
    "runEpoch",
    "resumes",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
