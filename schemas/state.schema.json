{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/state-v2.json",
  "title": "evoworkflow State v2",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "projectMode": {
      "type": "string",
      "enum": [
        "GREENFIELD",
        "BROWNFIELD",
        "EVO_MANAGED"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "IDLE",
        "INIT",
        "GRILL",
        "SPEC",
        "PLAN",
        "IMPLEMENT",
        "VERIFY",
        "REVIEW",
        "FINISH"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "DRAFT",
        "NEEDS_INFO",
        "AWAITING_APPROVAL",
        "APPROVED",
        "BLOCKED",
        "COMPLETED"
      ]
    },
    "activeChange": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeGoal": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "currentSlice": {
      "default": null,
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "slices": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "RUNNING",
              "PASS",
              "BLOCKED",
              "SKIPPED"
            ]
          },
          "blockReason": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "status",
          "blockReason"
        ],
        "additionalProperties": false
      }
    },
    "initializedAt": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schemaVersion",
    "projectMode",
    "phase",
    "status",
    "activeChange",
    "activeGoal",
    "currentSlice",
    "slices",
    "initializedAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
