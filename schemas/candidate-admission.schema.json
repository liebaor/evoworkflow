{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/candidate-admission-v1.json",
  "title": "evoworkflow Candidate Admission v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "evaluatedAt": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "REVIEW_ADMITTED",
        "NOT_READY"
      ]
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^G-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "PROTOCOL",
              "PROJECT"
            ]
          },
          "enforcement": {
            "type": "string",
            "enum": [
              "HARD",
              "WARNING"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN",
              "WARN"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "falsifyingCase": {
            "type": "string",
            "minLength": 1
          },
          "negativeRegression": {
            "type": "string",
            "minLength": 1
          },
          "remediation": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evaluatedAt": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "kind",
          "enforcement",
          "status",
          "title",
          "detail",
          "authority",
          "predicate",
          "falsifyingCase",
          "negativeRegression",
          "remediation",
          "evidence",
          "evaluatedAt"
        ],
        "additionalProperties": false
      }
    },
    "trace": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "change": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "updatedAt": {
          "type": "string",
          "minLength": 1
        },
        "inputFingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^AC-[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "implementationSurface": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "verification": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidenceRefs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^EV-[A-Za-z0-9][A-Za-z0-9_-]*$"
                }
              },
              "status": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "NOT_RUN"
                ]
              },
              "freshness": {
                "type": "string",
                "enum": [
                  "CURRENT",
                  "STALE",
                  "UNKNOWN",
                  "MISSING",
                  "CONFLICT"
                ]
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "title",
              "source",
              "implementationSurface",
              "verification",
              "evidenceRefs",
              "status",
              "freshness",
              "limitations"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "change",
        "updatedAt",
        "inputFingerprint",
        "items"
      ],
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "change": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
        },
        "generatedAt": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN",
            "MISSING",
            "CONFLICT"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "CURRENT",
                  "STALE",
                  "UNKNOWN",
                  "MISSING",
                  "CONFLICT"
                ]
              },
              "fingerprint": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inputFingerprint": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "changedInputs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "detail": {
                "type": "string",
                "minLength": 1
              },
              "generatedAt": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "kind",
              "status",
              "fingerprint",
              "inputFingerprint",
              "inputs",
              "changedInputs",
              "detail",
              "generatedAt"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "change",
        "generatedAt",
        "status",
        "entries"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "change",
    "evaluatedAt",
    "status",
    "reasons",
    "gates",
    "trace",
    "freshness"
  ],
  "additionalProperties": false
}
