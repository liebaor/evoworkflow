{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoworkflow.dev/schema/acceptance-trace-v1.json",
  "title": "evoworkflow Acceptance Trace v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "change": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "updatedAt": {
      "type": "string",
      "minLength": 1
    },
    "inputFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[A-Za-z0-9][A-Za-z0-9_-]*(?:\\.[A-Za-z0-9][A-Za-z0-9_-]*)*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "implementationSurface": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidenceRefs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^EV-[A-Za-z0-9][A-Za-z0-9_-]*$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "PASS",
              "FAIL",
              "BLOCKED",
              "NOT_RUN"
            ]
          },
          "freshness": {
            "type": "string",
            "enum": [
              "CURRENT",
              "STALE",
              "UNKNOWN",
              "MISSING",
              "CONFLICT"
            ]
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "source",
          "implementationSurface",
          "verification",
          "evidenceRefs",
          "status",
          "freshness",
          "limitations"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "change",
    "updatedAt",
    "inputFingerprint",
    "items"
  ],
  "additionalProperties": false
}
